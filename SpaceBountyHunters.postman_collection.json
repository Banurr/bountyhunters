          "name": "Filter and sort (min_reward, armed, sort=-reward)",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status code is 200', function () { pm.response.to.have.status(200); });", "pm.test('Response is an array', function () { pm.expect(pm.response.json()).to.be.an('array'); });"]}}],
          "request": {
            "method": "GET",
            "header": [],
            "url": {"raw": "http://localhost:8080/api/criminals/?min_reward=5000&armed=true&sort=-reward", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "criminals", ""], "query": [{"key": "min_reward", "value": "5000"}, {"key": "armed", "value": "true"}, {"key": "sort", "value": "-reward"}]}
