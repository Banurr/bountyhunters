          "request": {
            "method": "GET",
            "header": [],
            "url": {"raw": "http://localhost:8080/api/criminals/?has_crew=true&escape_master=true", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "criminals", ""], "query": [{"key": "has_crew", "value": "true"}, {"key": "escape_master", "value": "true"}]}
          }
