          "request": {
            "method": "GET",
            "header": [],
            "url": {"raw": "http://localhost:8080/api/hunts/", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "hunts", ""]}
          }
        },
        {
          "name": "Filter hunt logs by criminal_id",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status code is 200', function () { pm.response.to.have.status(200); });", "pm.test('Response is an array', function () { pm.expect(pm.response.json()).to.be.an('array'); });"]}}],
          "request": {
            "method": "GET",
            "header": [],
            "url": {"raw": "http://localhost:8080/api/hunts/?criminal_id=1", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "hunts", ""], "query": [{"key": "criminal_id", "value": "1"}]}
          }
        },
        {
