          }
        },
        {
          "name": "Create hunt log",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status code is 201', function () { pm.response.to.have.status(201); });"]}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"criminal_id\": 3,\n  \"success\": false,\n  \"notes\": \"Target escaped through an asteroid field.\"\n}", "options": {"raw": {"language": "json"}}},
            "url": {"raw": "http://localhost:8080/api/hunts/", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "hunts", ""]}
          }
        },
        {
          "name": "Get created hunt log (id 13)",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status code is 200', function () { pm.response.to.have.status(200); });"]}}],
          "request": {
            "method": "GET",
            "header": [],
            "url": {"raw": "http://localhost:8080/api/hunts/13/", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "hunts", "13", ""]}
          }
        },
        {
          "name": "Update hunt log (PATCH id 13)",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status code is 200', function () { pm.response.to.have.status(200); });"]}}],
          "request": {
            "method": "PATCH",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"success\": true,\n  \"notes\": \"Captured after the target ran out of fuel.\"\n}", "options": {"raw": {"language": "json"}}},
            "url": {"raw": "http://localhost:8080/api/hunts/13/", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "hunts", "13", ""]}
          }
        },
        {
          "name": "Delete hunt log (id 13)",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status code is 204', function () { pm.response.to.have.status(204); });"]}}],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {"raw": "http://localhost:8080/api/hunts/13/", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "hunts", "13", ""]}
          }
        },
        {
          "name": "Get hunt log after delete (404)",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status code is 404', function () { pm.response.to.have.status(404); });"]}}],
          "request": {
            "method": "GET",
            "header": [],
            "url": {"raw": "http://localhost:8080/api/hunts/13/", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "hunts", "13", ""]}
          }
        }
      ]
    },
