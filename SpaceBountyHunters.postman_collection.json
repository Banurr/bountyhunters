{
  "info": {
    "name": "Space Bounty Hunters API",
    "description": "Run the Hunt Logs folder in order on a fresh database. The seed data has 12 hunt logs, so the log created by 'Create hunt log' gets id 13 and the following requests use that id.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Criminals",
      "item": [
        {
          "name": "List all criminals",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status code is 200', function () { pm.response.to.have.status(200); });", "pm.test('Response is an array', function () { pm.expect(pm.response.json()).to.be.an('array'); });"]}}],
          "request": {
            "method": "GET",
            "header": [],
            "url": {"raw": "http://localhost:8080/api/criminals/", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "criminals", ""]}
          }
        },
        {
          "name": "Filter by reward range",
          "event": [{"listen": "test", "script": {"type": "text/javascript", "exec": ["pm.test('Status code is 200', function () { pm.response.to.have.status(200); });", "pm.test('Response is an array', function () { pm.expect(pm.response.json()).to.be.an('array'); });"]}}],
          "request": {
            "method": "GET",
            "header": [],
            "url": {"raw": "http://localhost:8080/api/criminals/?min_reward=10000&max_reward=30000", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "criminals", ""], "query": [{"key": "min_reward", "value": "10000"}, {"key": "max_reward", "value": "30000"}]}
